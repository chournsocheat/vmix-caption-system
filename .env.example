# ============================================================
# vMix Live Caption / Translation / QC System — Environment Config
# Copy this file to ".env" and fill in real values before running.
# ============================================================

# ---- Server ----
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser.
# Use "*" only for local/LAN testing.
CORS_ORIGIN=*

# ---- vMix ----
# IP address (or hostname) of the machine running vMix.
# Use 127.0.0.1 if this server runs on the same machine as vMix.
VMIX_IP=127.0.0.1
VMIX_PORT=8088
# vMix Web Controller shortcut auth (leave blank if vMix API auth is disabled)
VMIX_USER=
VMIX_PASS=
# Request timeout (ms) for calls to the vMix HTTP API
VMIX_TIMEOUT_MS=2500

# ---- vMix Overlay Targets ----
# Overlay 1 = original recognized speech. Overlay 2 = translated text.
# (Legacy VMIX_DEFAULT_INPUT / VMIX_DEFAULT_SELECTED_NAME, if set, are still
# read as a fallback for Overlay 1 when the OVERLAY1_* vars below are unset.)
VMIX_OVERLAY1_INPUT=OriginalCaption
VMIX_OVERLAY1_SELECTED_NAME=Caption.Text
VMIX_OVERLAY2_INPUT=TranslatedCaption
VMIX_OVERLAY2_SELECTED_NAME=Caption.Text
# Default overlay channel number used by the "Overlay In/Out" trigger buttons (1-4)
VMIX_DEFAULT_OVERLAY_CHANNEL=1

# ---- Translation Provider ----
# One of: google | google-adc | deepl | libre | none
# NOTE: LibreTranslate (Argos Translate) has NO Khmer model at all, and its
# public hosted instance now requires an API key for ANY request (even
# languages it does support) — see LIBRETRANSLATE_API_KEY below.
#
# "google-adc" (recommended if you already have a service account for
# Google Cloud STT): authenticates via GOOGLE_APPLICATION_CREDENTIALS — the
# SAME google-key.json already used for STT — so no separate API key string
# needs to live in this file at all. Requires the Cloud Translation API
# enabled on that project and the service account to have the "Cloud
# Translation API User" role (a different role from "Cloud Speech Client").
#
# "google" is the alternative if you'd rather use a plain API key instead of
# a service account — set GOOGLE_TRANSLATE_API_KEY below for that option.
TRANSLATION_PROVIDER=google-adc
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
# DeepL has separate Free vs Pro endpoints
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# Public/self-hosted LibreTranslate instance. The public libretranslate.com
# instance now requires an API key for all requests (get one at
# https://portal.libretranslate.com) — self-hosting avoids needing this.
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# ---- Quality Control ----
# Minimum STT confidence (0-100) required to render text normally.
MIN_CONFIDENCE=60
# What to do with text below MIN_CONFIDENCE: "mask" (replace with dots) or "skip"
LOW_CONFIDENCE_ACTION=mask
# Comma-separated list of banned words to censor (case-insensitive, whole-word)
BANNED_WORDS=damn,hell,shit,fuck,bitch,asshole

# ---- Caption line-wrapping ----
# Keeps subtitles from running to 3-4 lines and covering the video. Applied
# ONLY to the value actually sent to vMix — the Log Stream / Edit Zone always
# show the full, untruncated text.
CAPTION_MAX_CHARS_PER_LINE=78
CAPTION_MAX_LINES=2

# ---- Google Cloud Speech-to-Text ("Google Cloud Auto Multi-Language" mode) ----
# Optional — only needed if you use the Google Cloud STT mode toggle in the UI.
#
# IMPORTANT: this uses the Speech-to-Text V2 API's Chirp 2 model specifically.
# Per Google's own supported-languages table, Khmer (km-KH) streaming
# recognition is NOT available under any V1 model (default/latest_long/
# latest_short/command_and_search) — only under V2's chirp/chirp_2 models,
# and only in certain regions. Verify at: https://cloud.google.com/speech-to-text/docs/languages
#
# Setup:
# 1. In Google Cloud Console: enable the "Cloud Speech-to-Text API", create a
#    service account, grant it the "Cloud Speech Client" role, and download
#    its JSON key.
# 2. Point this at that key file (the @google-cloud/speech client reads it
#    automatically — never paste key contents directly into this file):
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Your GCP project ID, needed to build the V2 API's "recognizer" resource
# path. If left blank, the server tries to auto-detect it from the service
# account credentials above — set this explicitly if that fails.
GOOGLE_CLOUD_PROJECT_ID=
# Languages Google STT listens for simultaneously in this mode. The language
# picked in the UI's Source Speech Language dropdown becomes the primary
# language; up to 3 of the remaining entries here are combined with it into
# one languageCodes list, so it can auto-detect switching between them
# (e.g. Khmer mixed with English) within the same stream.
GOOGLE_CLOUD_STT_ALTERNATIVE_LANGS=km-KH,en-US
# Fallback sample rate ONLY used if a client somehow doesn't report its
# actual AudioContext rate — in normal operation the browser always sends
# its real rate (auto-detected client-side), since some browsers/drivers
# silently ignore the requested 16000Hz and use their native rate instead.
GOOGLE_CLOUD_STT_SAMPLE_RATE=16000
# Chirp 2 supports streaming (plain "chirp" does not — Recognize/BatchRecognize
# only). Region matters: Chirp 2 is documented GA in us-central1 and
# europe-west4; asia-southeast1 has appeared in Google's language tables for
# Khmer but may need project allowlisting. If you get a "not found"/
# "permission denied"/"invalid argument" error mentioning the model or
# region, try GOOGLE_CLOUD_STT_REGION=us-central1 instead.
GOOGLE_CLOUD_STT_MODEL=chirp_2
GOOGLE_CLOUD_STT_REGION=asia-southeast1


# ---- Session / Logging ----
LOG_LEVEL=info
# Max number of STT log entries kept in memory per session
MAX_LOG_HISTORY=500
