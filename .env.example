# ============================================================
# vMix Live Caption / Translation / QC System — Environment Config
# Copy this file to ".env" and fill in real values before running.
# ============================================================

# ---- Server ----
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser.
# Use "*" only for local/LAN testing.
CORS_ORIGIN=*

# ---- vMix ----
# IP address (or hostname) of the machine running vMix.
# Use 127.0.0.1 if this server runs on the same machine as vMix.
VMIX_IP=127.0.0.1
VMIX_PORT=8088
# vMix Web Controller shortcut auth (leave blank if vMix API auth is disabled)
VMIX_USER=
VMIX_PASS=
# Request timeout (ms) for calls to the vMix HTTP API
VMIX_TIMEOUT_MS=2500

# ---- vMix Overlay Targets ----
# Overlay 1 = original recognized speech. Overlay 2 = translated text.
# (Legacy VMIX_DEFAULT_INPUT / VMIX_DEFAULT_SELECTED_NAME, if set, are still
# read as a fallback for Overlay 1 when the OVERLAY1_* vars below are unset.)
VMIX_OVERLAY1_INPUT=OriginalCaption
VMIX_OVERLAY1_SELECTED_NAME=Caption.Text
VMIX_OVERLAY2_INPUT=TranslatedCaption
VMIX_OVERLAY2_SELECTED_NAME=Caption.Text
# Default overlay channel number used by the "Overlay In/Out" trigger buttons (1-4)
VMIX_DEFAULT_OVERLAY_CHANNEL=1

# ---- Translation Provider ----
# One of: google | deepl | libre | none
# NOTE: LibreTranslate (Argos Translate) has NO Khmer model at all — if your
# workflow targets Khmer, use "google" here with GOOGLE_TRANSLATE_API_KEY set.
# Libre works fine for en/zh/fr/ar/ru/es.
TRANSLATION_PROVIDER=libre
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
# DeepL has separate Free vs Pro endpoints
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# Public/self-hosted LibreTranslate instance (no key needed for public demo instance,
# but public instances are rate-limited — self-host for production reliability)
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# ---- Quality Control ----
# Minimum STT confidence (0-100) required to render text normally.
MIN_CONFIDENCE=60
# What to do with text below MIN_CONFIDENCE: "mask" (replace with dots) or "skip"
LOW_CONFIDENCE_ACTION=mask
# Comma-separated list of banned words to censor (case-insensitive, whole-word)
BANNED_WORDS=damn,hell,shit,fuck,bitch,asshole

# ---- Caption line-wrapping ----
# Keeps subtitles from running to 3-4 lines and covering the video. Applied
# ONLY to the value actually sent to vMix — the Log Stream / Edit Zone always
# show the full, untruncated text.
CAPTION_MAX_CHARS_PER_LINE=78
CAPTION_MAX_LINES=2

# ---- Google Cloud Speech-to-Text ("Google Cloud Auto Multi-Language" mode) ----
# Optional — only needed if you use the Google Cloud STT mode toggle in the UI.
# 1. In Google Cloud Console: enable the "Cloud Speech-to-Text API", create a
#    service account, grant it the "Cloud Speech Client" role, and download
#    its JSON key.
# 2. Point this at that key file (the @google-cloud/speech client reads it
#    automatically — never paste key contents directly into this file):
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Languages Google STT listens for simultaneously in this mode. The language
# picked in the UI's Source Speech Language dropdown becomes the primary
# languageCode; up to 3 of the remaining entries here are sent as
# alternativeLanguageCodes so it can auto-detect switching between them
# (e.g. Khmer mixed with English) within the same stream.
GOOGLE_CLOUD_STT_ALTERNATIVE_LANGS=km-KH,en-US
GOOGLE_CLOUD_STT_SAMPLE_RATE=16000
GOOGLE_CLOUD_STT_MODEL=latest_long

# ---- Session / Logging ----
LOG_LEVEL=info
# Max number of STT log entries kept in memory per session
MAX_LOG_HISTORY=500
